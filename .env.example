# Public website environment
# Browser calls use the same-origin /api path. Server-side reads use the
# private API address on the VPS.

NEXT_PUBLIC_API_URL=/
API_INTERNAL_URL=http://127.0.0.1:3101
NEXT_PUBLIC_SITE_URL=https://venueonmyplate.in

# Keep 0 while the site is opened over plain HTTP (for example an IP address).
# Set to 1 only after HTTPS is configured; otherwise browsers rewrite CSS and
# JavaScript requests to HTTPS and the page appears as unstyled HTML.
CSP_UPGRADE_INSECURE_REQUESTS=0
